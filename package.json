{
  "name": "steelyes",
  "version": "0.0.1",
  "private": true,
  "description": "Steelyes - A modern web application",
  "license": "Proprietary",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "e2e": "turbo run e2e",
    "photo:audit": "node scripts/photo-audit.mjs",
    "photo:browser": "python3 scripts/photo-browser.py --source '/Volumes/SSDRubb/foto steelyes' --output docs/frontend/photo-browser --title 'Steelyes Client Photo Browser'"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "turbo": "^2.9.6"
  }
}
