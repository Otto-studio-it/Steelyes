# Steelyes web — copy to apps/web/.env.local (never commit .env.local)

# --- Required (client + server) ---
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]

# --- Required (server only; used at build for server components) ---
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]
RESEND_API_KEY=[resend-api-key]

# --- Recommended ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional feature flags ---
# NEXT_PUBLIC_CONFIGURATOR_3D_PREVIEW=true

# --- Public site hold (temporary pause; keeps SEO via 503 + Retry-After) ---
# SITE_HOLD=true
# Bypass preview: open https://yoursite/?hold_bypass=YOUR_TOKEN (sets cookie 30d). Clear: ?hold_bypass=off
# SITE_HOLD_BYPASS_TOKEN=
# Shown on hold page as mailto (e.g. studio ops inbox — not "client unpaid" copy)
# SITE_HOLD_CONTACT_EMAIL=amministrazione@otto-studio.it

# --- Cookiebot CMP (optional until Domain Group ID is created in Cookiebot) ---
# NEXT_PUBLIC_COOKIEBOT_ID=

# --- Cloudflare Turnstile ---
# Optional in dev (`next dev` skips the bot check when the secret is missing).
# REQUIRED in production: without TURNSTILE_SECRET_KEY the quote / contact / email-my-design
# forms reject every submission (fail closed). Both keys must be set together.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Temporary escape hatch only — accepts submissions without a bot check in production:
# TURNSTILE_ALLOW_UNVERIFIED=true


# --- Email (Resend domain verified — from + workshop inbox) ---
# RESEND_FROM=Steelyes <info@steelyes.co.uk>
# WORKSHOP_EMAIL=info@steelyes.co.uk
# Signing secret for POST /api/webhooks/resend (starts with whsec_).
# RESEND_WEBHOOK_SECRET=

# --- Tenant lead webhook (optional) ---
# TENANT_LEAD_WEBHOOK_URL=https://hooks.example.com/steelyes-leads

# --- Inbox ingest (optional; route 503s until set, like CRON_SECRET below) ---
# Shared secret for /api/inbox/ingest, called by scripts/gmail-inbox-autoack.gs.
# Must match SITE_INGEST_SECRET pasted into that script. Generate with:
# openssl rand -hex 24
# INBOX_INGEST_SECRET=

# --- Cron (optional; route 503s until set) ---
# CRON_SECRET=

# --- E2E only (local/CI; not required for pnpm dev) ---
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
