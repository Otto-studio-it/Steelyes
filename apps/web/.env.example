# Steelyes web — copy to apps/web/.env.local (never commit .env.local)

# --- Required (client + server) ---
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]

# --- Required (server only; used at build for server components) ---
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]
RESEND_API_KEY=[resend-api-key]

# --- Recommended ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional feature flags ---
# NEXT_PUBLIC_CONFIGURATOR_3D_PREVIEW=true

# --- E2E only (local/CI; not required for pnpm dev) ---
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
