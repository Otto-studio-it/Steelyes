# Steelyes web — copy to apps/web/.env.local (never commit .env.local)

# --- Required (client + server) ---
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]

# --- Required (server only; used at build for server components) ---
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]
RESEND_API_KEY=[resend-api-key]

# --- Recommended ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional feature flags ---
# NEXT_PUBLIC_CONFIGURATOR_3D_PREVIEW=true

# --- Cookiebot CMP (optional until Domain Group ID is created in Cookiebot) ---
# NEXT_PUBLIC_COOKIEBOT_ID=

# --- Cloudflare Turnstile (optional; omit to skip bot check in dev) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=


# --- Email (Resend domain verified — from + workshop inbox) ---
# RESEND_FROM=Steelyes <info@steelyes.co.uk>
# WORKSHOP_EMAIL=info@steelyes.co.uk
# Signing secret for POST /api/webhooks/resend (starts with whsec_).
# RESEND_WEBHOOK_SECRET=

# --- Tenant lead webhook (optional) ---
# TENANT_LEAD_WEBHOOK_URL=https://hooks.example.com/steelyes-leads

# --- Inbox ingest (optional; route 503s until set, like CRON_SECRET below) ---
# Shared secret for /api/inbox/ingest, called by scripts/gmail-inbox-autoack.gs.
# Must match SITE_INGEST_SECRET pasted into that script. Generate with:
# openssl rand -hex 24
# INBOX_INGEST_SECRET=

# --- Cron (optional; route 503s until set) ---
# CRON_SECRET=

# --- E2E only (local/CI; not required for pnpm dev) ---
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
