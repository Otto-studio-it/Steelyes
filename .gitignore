# Dependencies
node_modules/
.pnpm-store/

# Build & output
.next/
dist/
out/
build/
coverage/

# Environment
.env
.env.local
.env.*.local

# IDE & OS
.DS_Store
# AppleDouble / resource fork noise (any depth)
._*
**/._*
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Raw/unprocessed assets (commit processed assets only)
assets-raw/**
!assets-raw/.gitkeep

# Heavy design files (never commit)
*.psd
*.ai
*.sketch
*.fig
*.zip
*.mov
*.mp4

# Misc
.turbo/

# Local tooling / analysis output (never commit)
graphify-out/
.claude/worktrees/

# Agent skill caches (skills live in user profile; repo copies are optional)
.agents/skills/**/__pycache__/

# Local tooling / Supabase CLI cache (never commit)
playwright-report/
test-results/
supabase/.temp/
apps/web/supabase/.temp/

# Stray local screenshots and design dumps
docs/**/*.png
docs/**/*.jpg
!docs/frontend/photo-browser/**
